	"lines": [
		"git diff unifiedとは何？",
		"[public.icon]",
		"[Github]",
		"$ git diff --unified=3",
		"",
		" code:md",
		"  git diff で表示される標準的な差分形式のことです。- で削除行、+",
		"    で追加行を表し、変更箇所の前後数行のコンテキストも含めて表示されます。",
		"  ",
		"    @@ -10,4 +10,4 @@",
		"     変更なしの行",
		"    -削除される行",
		"    +追加される行",
		"     変更なしの行",
		"",
		""
	]
}
